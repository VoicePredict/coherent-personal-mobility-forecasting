{
  "experiment_name": "coherent_personal_mobility_forecasting_final",
  "data_selection": {
    "dataset_name": "GeoLife GPS Trajectories",
    "required_release": "1.3",
    "official_download_page": "https://www.microsoft.com/en-us/download/details.aspx?id=52367",
    "official_archive_filename": "Geolife Trajectories 1.3.zip",
    "official_archive_size_bytes": 313164406,
    "official_archive_sha256": "1107c5ac064d0a23c8d021a8736a77e53abc75b227062e6260342c6a8d86bdb6",
    "archive_root_directory": "Geolife Trajectories 1.3",
    "expected_user_directories": 182,
    "expected_plt_files": 18670,
    "expected_label_files": 69,
    "trajectory_unit": "one original PLT file",
    "manual_segmentation": false,
    "row_level_mode_filtering": false,
    "min_valid_points_per_trajectory": 10,
    "min_duration_seconds": 300,
    "min_eligible_trajectories_per_user": 20,
    "preserve_all_valid_points": true,
    "allowed_modes": ["train", "taxi", "walk", "bus", "subway", "car", "bike", "unknown"],
    "explicit_non_ground_modes": ["airplane", "plane", "aircraft", "helicopter", "heli", "boat", "ferry", "ship", "watercraft", "submarine"],
    "transportation_mode_policy": "exclude_a_complete_source_trajectory_if_any_explicit_label_is_not_allowed",
    "unknown_mode_policy": "retain_and_audit",
    "large_gap_policy": "audit_only",
    "high_implied_speed_policy": "audit_only"
  },
  "preprocessing": {
    "datasets": [
      {
        "name": "geolife_ground",
        "raw_path": "outputs/private/source_preparation/private/geolife_source.csv.gz",
        "prepared_path": "outputs/private/base_forecast/prepared_data/geolife_ground.csv",
        "source_format": "standard_csv",
        "mode_column": "Transportation Mode",
        "include_modes": ["train", "taxi", "walk", "bus", "subway", "car", "bike", "unknown"],
        "exclude_mode_patterns": ["airplane", "plane", "aircraft", "helicopter", "heli", "boat", "ferry", "ship", "watercraft", "submarine"],
        "min_trips_per_user": 20
      },
      {
        "name": "gta_ground",
        "raw_path": "data/raw/trips_lines_GTA.csv.gz",
        "prepared_path": "outputs/private/base_forecast/prepared_data/gta_ground.csv",
        "source_format": "gta_decimal_comma_csv",
        "mode_column": "Transportation Mode",
        "include_modes": ["compacts", "sedans", "sports", "offroad", "service", "vans", "coupes", "suvs", "utility", "motorcycles", "commercial", "sportsclassics", "cycles", "muscle", "emergency", "industrial", "military", "super"],
        "exclude_mode_patterns": ["airplane", "plane", "aircraft", "helicopter", "heli", "boat", "ferry", "ship", "watercraft", "submarine"],
        "min_trips_per_user": 20
      }
    ]
  },
  "datasets": [
    {
      "name": "geolife_ground",
      "label": "GeoLife source-faithful retained mobility including cycling",
      "path": "outputs/private/base_forecast/prepared_data/geolife_ground.csv",
      "epsg": "EPSG:4326",
      "kind": "geolife"
    },
    {
      "name": "gta_ground",
      "label": "GTA-V ground vehicle histories",
      "path": "outputs/private/base_forecast/prepared_data/gta_ground.csv",
      "epsg": "EPSG:32611",
      "kind": "gta"
    }
  ],
  "experiment": {
    "projection_strategy": "train_centered_aeqd",
    "min_trips_per_driver": 20,
    "min_points_per_trip": 10,
    "min_duration_min": 5.0,
    "train_fraction": 0.75,
    "observed_fraction": 0.66,
    "lookahead_minutes": 5.0,
    "grid_cell_size_m": 350.0,
    "grid_route_max_steps": 30,
    "grid_route_beam_width": 8,
    "grid_destination_top_k_candidates": 3,
    "splits": [
      {"label": "random_seed13", "mode": "random", "seed": 13},
      {"label": "chronological", "mode": "chronological", "seed": 42}
    ],
    "destination_cluster_eps_m": 500.0,
    "destination_cluster_min_radius_m": 200.0,
    "destination_analogue_top_k": 15,
    "destination_top_k_candidates": 3,
    "analogue_current_sigma_m": 1200.0,
    "analogue_start_sigma_m": 2500.0,
    "analogue_time_sigma_hours": 4.0,
    "analogue_speed_sigma_log": 0.8,
    "train_analogue_score_threshold": 0.45,
    "coherence_threshold_m": 500.0,
    "abstain_confidence_threshold": 0.48,
    "route_eval_steps": 10,
    "route_step_threshold_m": 350.0
  }
}
